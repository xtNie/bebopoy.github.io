{
  "name": "sutton-photo-journal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/sync-photos.mjs --input src/data/albums.json && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "photos:sync": "node scripts/sync-photos.mjs",
    "photos:import": "node scripts/import-local.mjs"
  },
  "dependencies": {
    "astro": "^5.16.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.19.0"
  }
}
