---
import Layout from '../layouts/Layout.astro';
import { site, url, photoUrl } from '../data/site';
import { featuredResearch, researchTypeLabel } from '../data/research';
import { posts } from '../data/posts';
import { albums, coverOf } from '../data/photos';
const selectedAlbums = albums.slice(0, 3);
---
<Layout>
  <section class="profile-intro" aria-labelledby="name">
    <div>
      <h1 id="name">{site.name}</h1>
      <p class="affiliation">{site.affiliation}</p>
      <div class="profile-bio">
        <p>I am currently at the University of Chinese Academy of Sciences. Previously, I studied Intelligent Science and Technology at Shanghai University.</p>
      </div>
      <div class="contact-links">
        <a href={`mailto:${site.email}`}>Email</a>
        <a href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a>
        <a href={url('about/')}>About</a>
      </div>
    </div>
  </section>

  <section class="home-section" aria-labelledby="research-heading">
    <div class="section-label"><h2 id="research-heading">Research</h2><a href={url('research/')}>View research ↗</a></div>
    <div class="section-body">
      <p class="interest-text">My interests lie in artificial intelligence and its applications in industrial settings.</p>
      {featuredResearch.length > 0 && <div class="research-list">
        {featuredResearch.map(item => <article class="research-item">
          <p class="research-meta">{item.year} · {researchTypeLabel[item.type]}</p>
          <h3><a href={url(`research/${item.slug}/`)}>{item.title}</a></h3>
          {item.authors && <p class="research-authors">{item.authors.join(', ')}</p>}
          {item.venue && <p class="research-venue">{item.venue}</p>}
          <p class="research-summary">{item.summary}</p>
        </article>)}
      </div>}
    </div>
  </section>

  {posts.length > 0 && <section class="home-section" aria-labelledby="writing-heading">
    <div class="section-label"><h2 id="writing-heading">Writing</h2><a href={url('writing/')}>All writing ↗</a></div>
    <div class="section-body text-list">
      {posts.slice(0, 3).map(post => <a class="article-row" href={url(`p/${post.slug}/`)}><h3>{post.title}</h3>{post.date && <time datetime={post.date.slice(0, 10)}>{post.date.slice(0, 10)}</time>}</a>)}
    </div>
  </section>}

  {selectedAlbums.length > 0 && <section class="home-section photography-preview" aria-labelledby="photography-heading">
    <div class="section-label"><h2 id="photography-heading">Photography</h2><a href={url('photography/')}>View collections ↗</a></div>
    <div class="section-body">
      <div class="photo-preview-grid">
        {selectedAlbums.map(album => {
          const photo = coverOf(album);
          const thumb = photo.variants?.[0] || photo;
          return <a href={url(`series/${album.slug}/`)} class="photo-preview-item">
            <div class="photo-preview-image"><img src={photoUrl(thumb.src)} alt={photo.alt} width={thumb.width} height={thumb.height} loading="lazy" decoding="async" /></div>
            <span>{album.title}</span>
          </a>;
        })}
      </div>
      {selectedAlbums.some(album => album.demo) && <p class="sample-note">Sample photographs from Unsplash. Credits accompany each image.</p>}
    </div>
  </section>}
</Layout>
