---
import Layout from '../layouts/Layout.astro';
import { albums, coverOf } from '../data/photos';
import { url, photoUrl } from '../data/site';
const categories = [...new Set(albums.map(album => album.category))];
---
<Layout>
  <header class="gallery-header">
    <h1>摄影集</h1>
    <div class="filters" role="group" aria-label="筛选摄影系列">
      <button class="active" data-filter="all" aria-pressed="true">全部</button>
      {categories.map(category => <button data-filter={category} aria-pressed="false">{category}</button>)}
    </div>
  </header>
  <p class="sr-only" id="filter-status" aria-live="polite">{albums.length} 个系列</p>
  <div class="album-grid">
    {albums.map((album, index) => {
      const photo = coverOf(album);
      return <article class:list={['album-card', { 'album-featured': index === 0 }]} data-category={album.category}>
        <a class="album-image" href={url(`series/${album.slug}/`)} aria-label={`浏览${album.title}，${album.photos.length}张照片`}>
          <img
            src={photoUrl(photo.src)}
            srcset={photo.variants?.map(variant => `${photoUrl(variant.src)} ${variant.width}w`).join(', ')}
            sizes={index === 0 ? '(max-width: 760px) calc(100vw - 40px), (max-width: 1200px) calc(100vw - 96px), 1104px' : '(max-width: 760px) calc(100vw - 40px), (max-width: 1200px) calc((100vw - 144px) / 2), 528px'}
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            decoding="async"
          />
        </a>
        <div class="album-caption">
          <a href={url(`series/${album.slug}/`)}><h2>{album.title}</h2></a>
          <span>{album.photos.length} 张{album.demo ? ' · 样片' : ` · ${album.year}`}</span>
        </div>
      </article>;
    })}
  </div>
  {albums.some(album => album.demo) && <p class="demo-note gallery-note">当前展示示例照片，作者与来源见各系列。</p>}
  <script>
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-category]')];
    const grid = document.querySelector('.album-grid');
    buttons.forEach(button => button.addEventListener('click', () => {
      buttons.forEach(item => {
        item.classList.toggle('active', item === button);
        item.setAttribute('aria-pressed', String(item === button));
      });
      let count = 0;
      cards.forEach(card => {
        card.hidden = button.dataset.filter !== 'all' && card.dataset.category !== button.dataset.filter;
        if (!card.hidden) count++;
      });
      grid?.classList.toggle('is-filtered', button.dataset.filter !== 'all');
      document.querySelector('#filter-status')!.textContent = `${count} 个系列`;
    }));
  </script>
</Layout>
