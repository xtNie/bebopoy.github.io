---
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import Lightbox from '../../components/Lightbox.astro';
import {albums} from '../../data/photos';
import {url} from '../../data/site';
export function getStaticPaths(){return albums.map((album,i)=>({params:{slug:album.slug},props:{album,i}}))}
const {album,i}=Astro.props;
const next=albums[(i+1)%albums.length];
const details=[album.location,`${album.photos.length} 张照片`,album.demo?'示例照片':String(album.year)].filter(Boolean).join(' · ');
---
<Layout title={album.title} description={album.description}>
  <a class="back-link" href={url()}>← 摄影集</a>
  <header class="series-header"><h1>{album.title}</h1><p class="series-description">{album.description}</p><p class="series-details">{details}</p></header>
  <div class="series-photos">{album.photos.map((photo,index)=><Photo photo={photo} eager={index===0} index={index}/>)}</div>
  <a class="next-series" href={url(`series/${next.slug}/`)}><span>下一组</span><span>{next.title} <span>→</span></span></a>
  <Lightbox/>
</Layout>
