<dialog id="lightbox" aria-label="Photograph viewer">
  <div class="lightbox-bar"><span id="lightbox-counter" aria-live="polite"></span><div><button id="lightbox-zoom" aria-label="Zoom in">Zoom in +</button><button id="lightbox-close" aria-label="Close photograph viewer">Close ×</button></div></div>
  <button id="lightbox-prev" class="lightbox-arrow prev" aria-label="Previous photograph">←</button>
  <div id="lightbox-stage"><img id="lightbox-image" alt=""/></div>
  <button id="lightbox-next" class="lightbox-arrow next" aria-label="Next photograph">→</button>
  <p id="lightbox-caption"></p>
</dialog>
<script>
  const dialog=document.querySelector<HTMLDialogElement>('#lightbox')!;
  const image=document.querySelector<HTMLImageElement>('#lightbox-image')!;
  const stage=document.querySelector<HTMLElement>('#lightbox-stage')!;
  const triggers=[...document.querySelectorAll<HTMLButtonElement>('[data-photo]')];
  const zoomButton=document.querySelector<HTMLButtonElement>('#lightbox-zoom')!;
  const previous=document.querySelector<HTMLButtonElement>('#lightbox-prev')!;
  const next=document.querySelector<HTMLButtonElement>('#lightbox-next')!;
  let activePhotos=triggers;
  let index=0;
  let opener:HTMLElement|null=null;
  function setZoom(zoom:boolean){stage.classList.toggle('zoomed',zoom);zoomButton.textContent=zoom?'Fit −':'Zoom in +';zoomButton.setAttribute('aria-label',zoom?'Fit photograph to screen':'Zoom in');}
  function show(position:number){
    if(!activePhotos.length)return;
    index=(position+activePhotos.length)%activePhotos.length;
    const item=activePhotos[index];
    image.src=item.dataset.src!;
    image.alt=item.dataset.alt!;
    document.querySelector('#lightbox-caption')!.textContent=item.dataset.caption!;
    document.querySelector('#lightbox-counter')!.textContent=`${index+1} / ${activePhotos.length}`;
    previous.disabled=next.disabled=activePhotos.length<2;
    setZoom(false);stage.scrollTo(0,0);
  }
  function close(){dialog.close();document.body.classList.remove('lightbox-open');opener?.focus();}
  triggers.forEach(trigger=>trigger.addEventListener('click',()=>{
    activePhotos=triggers.filter(item=>item.getClientRects().length>0);
    opener=trigger;show(activePhotos.indexOf(trigger));dialog.showModal();document.body.classList.add('lightbox-open');
  }));
  document.querySelector('#lightbox-close')?.addEventListener('click',close);
  dialog.addEventListener('cancel',event=>{event.preventDefault();close();});
  previous.addEventListener('click',()=>show(index-1));next.addEventListener('click',()=>show(index+1));
  zoomButton.addEventListener('click',()=>setZoom(!stage.classList.contains('zoomed')));
  dialog.addEventListener('keydown',event=>{if(event.key==='ArrowLeft'){event.preventDefault();show(index-1);}if(event.key==='ArrowRight'){event.preventDefault();show(index+1);}});
  let touchX=0;let touchY=0;
  stage.addEventListener('touchstart',event=>{touchX=event.changedTouches[0].screenX;touchY=event.changedTouches[0].screenY;},{passive:true});
  stage.addEventListener('touchend',event=>{if(stage.classList.contains('zoomed'))return;const dx=event.changedTouches[0].screenX-touchX;const dy=event.changedTouches[0].screenY-touchY;if(Math.abs(dx)>70&&Math.abs(dx)>Math.abs(dy))show(index+(dx<0?1:-1));},{passive:true});
</script>
