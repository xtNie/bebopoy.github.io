---
import '../styles/global.css';
import { site, url } from '../data/site';
interface Props { title?: string; description?: string; active?: string }
const { title, description = site.description, active = 'series' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = [
  { key: 'series', label: '摄影集', path: '' },
  { key: 'recent', label: '近期', path: 'recent/' },
  { key: 'journal', label: '文字', path: 'journal/' },
  { key: 'about', label: '关于', path: 'about/' },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — ${site.name}` : site.title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta property="og:title" content={title || site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('photo-theme') || 'light'; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到内容</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href={url()} aria-label="Sutton 首页">Sutton</a>
        <nav class="main-nav" aria-label="主导航">
          {links.map(link => <a href={url(link.path)} aria-current={active === link.key ? 'page' : undefined}>{link.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <div class="footer-links">
          <a href={site.github} target="_blank" rel="noreferrer">GitHub</a>
          <a href={`mailto:${site.email}`}>联系</a>
          <button id="theme-toggle" aria-label="切换深色外观">深色外观</button>
        </div>
      </div>
    </footer>
    <script>
      const theme = document.querySelector<HTMLButtonElement>('#theme-toggle');
      function updateThemeLabel() {
        const dark = document.documentElement.dataset.theme === 'dark';
        if (theme) {
          theme.textContent = dark ? '浅色外观' : '深色外观';
          theme.setAttribute('aria-label', dark ? '切换浅色外观' : '切换深色外观');
        }
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#161617' : '#ffffff');
      }
      updateThemeLabel();
      theme?.addEventListener('click', () => {
        const mode = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = mode;
        try { localStorage.setItem('photo-theme', mode); } catch {}
        updateThemeLabel();
      });
    </script>
  </body>
</html>
