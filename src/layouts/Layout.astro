---
import '../styles/global.css';
import { site, url } from '../data/site';
interface Props { title?: string; description?: string; active?: string; wide?: boolean }
const { title, description = site.description, active = 'home', wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = [
  { key: 'research', label: 'Research', path: 'research/' },
  { key: 'writing', label: 'Writing', path: 'writing/' },
  { key: 'photography', label: 'Photography', path: 'photography/' },
  { key: 'about', label: 'About', path: 'about/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — ${site.name}` : site.title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta property="og:title" content={title || site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="author" content={site.name} />
    <slot name="head" />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('photo-theme') || 'light'; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href={url()} aria-label={`${site.name} — home`}>{site.name}</a>
        <nav class="main-nav" aria-label="Main navigation">
          {links.map(link => <a href={url(link.path)} aria-current={active === link.key ? 'page' : undefined}>{link.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main" class:list={{ wide }}><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <div class="footer-links">
          <a href={site.github} target="_blank" rel="noreferrer">GitHub</a>
          <a href={`mailto:${site.email}`}>Email</a>
          <button id="theme-toggle" aria-label="Switch to dark appearance">Dark appearance</button>
        </div>
      </div>
    </footer>
    <script>
      const theme = document.querySelector<HTMLButtonElement>('#theme-toggle');
      function updateThemeLabel() {
        const dark = document.documentElement.dataset.theme === 'dark';
        if (theme) {
          theme.textContent = dark ? 'Light appearance' : 'Dark appearance';
          theme.setAttribute('aria-label', dark ? 'Switch to light appearance' : 'Switch to dark appearance');
        }
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#161617' : '#ffffff');
      }
      updateThemeLabel();
      theme?.addEventListener('click', () => {
        const mode = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = mode;
        try { localStorage.setItem('photo-theme', mode); } catch {}
        updateThemeLabel();
      });
    </script>
  </body>
</html>
